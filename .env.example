# Required — Mistral AI API key for chat and embeddings
MISTRAL_API_KEY=

# Required — GitHub personal access token for issue search
GITHUB_TOKEN=

# Optional — Telegram bot integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=

# Whisper transcription provider: "mistral" (default) or "local"
WHISPER_PROVIDER=mistral
# URL for local Whisper server (only used when WHISPER_PROVIDER=local)
WHISPER_URL=

# Phoenix
PORT=4000
SECRET_KEY_BASE=
