{
  "uid": "hexgh-ai-tokens",
  "title": "HexGh - AI Token & Model Usage",
  "tags": ["hexgh", "ai", "mistral"],
  "timezone": "browser",
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "title": "Total Tokens Rate by Model (Rate / 5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus_hexgh" },
      "targets": [
        {
          "expr": "sum by (model) (rate(hex_gh_ai_mistral_total_tokens_total[5m]))",
          "legendFormat": "{{ model }}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "title": "Token Share by Model",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "uid": "prometheus_hexgh" },
      "targets": [
        {
          "expr": "sum by (model) (hex_gh_ai_mistral_total_tokens_total)",
          "legendFormat": "{{ model }}"
        }
      ]
    },
    {
      "title": "Total API Requests Count",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "uid": "prometheus_hexgh" },
      "targets": [
        {
          "expr": "sum(hex_gh_ai_mistral_request_total)",
          "legendFormat": "Total Requests"
        }
      ]
    },
    {
      "title": "Prompt vs Completion Tokens",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "uid": "prometheus_hexgh" },
      "targets": [
        {
          "expr": "sum by (model) (rate(hex_gh_ai_mistral_prompt_tokens_total[5m]))",
          "legendFormat": "Prompt - {{ model }}"
        },
        {
          "expr": "sum by (model) (rate(hex_gh_ai_mistral_completion_tokens_total[5m]))",
          "legendFormat": "Completion - {{ model }}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "title": "Knowledge Base",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false
    },
    {
      "title": "KB Decisions",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 17 },
      "datasource": { "uid": "prometheus_hexgh" },
      "targets": [
        {
          "expr": "sum by (action, had_neighbors) (hex_gh_knowledge_decision_total)",
          "legendFormat": "{{ action }} (neighbors={{ had_neighbors }})"
        }
      ]
    },
    {
      "title": "Similarity When Creating Despite Neighbors",
      "description": "High values (>0.8) suggest the model is being lazy and should merge instead of creating.",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 17 },
      "datasource": { "uid": "prometheus_hexgh" },
      "targets": [
        {
          "expr": "hex_gh_knowledge_decision_similarity_bucket{action=\"create\", had_neighbors=\"true\"}",
          "legendFormat": "≤{{ le }}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "vertical",
        "barWidth": 0.8,
        "showValue": "always",
        "stacking": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "≤+Inf" },
            "properties": [{ "id": "custom.hideFrom", "value": { "legend": true, "tooltip": true, "viz": true } }]
          }
        ]
      }
    },
    {
      "title": "KB Decisions Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 17 },
      "datasource": { "uid": "prometheus_hexgh" },
      "targets": [
        {
          "expr": "sum by (action, strategy) (increase(hex_gh_knowledge_decision_total[1h]))",
          "legendFormat": "{{ action }}/{{ strategy }}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "drawStyle": "bars",
        "stacking": { "mode": "normal" }
      }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "schemaVersion": 39
}
