<!DOCTYPE html>
<html>
  <head>
    <title>Login - HexGh MCP</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 400px; margin: 80px auto; padding: 0 20px; }
      h1 { color: #333; }
      form { display: flex; flex-direction: column; gap: 12px; }
      label { font-weight: 500; }
      input { padding: 8px; border: 1px solid #ccc; border-radius: 4px; }
      button { padding: 10px; background: #4f46e5; color: white; border: none; border-radius: 4px; cursor: pointer; }
      button:hover { background: #4338ca; }
      .error { color: #dc2626; margin-bottom: 12px; }
    </style>
  </head>
  <body>
    <h1>MCP Login</h1>
    <p :if={@flash["error"]} class="error">{@flash["error"]}</p>
    <form method="POST" action={~p"/oauth/login"}>
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <input type="hidden" name="return_to" value={@return_to} />
      <label>
        Username <input type="text" name="username" required autofocus />
      </label>
      <label>
        Password <input type="password" name="password" required />
      </label>
      <button type="submit">Login</button>
    </form>
  </body>
</html>
